rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isSuperAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "superadmin";
    }

    match /users/{uid} {
      // A user can read their own profile; a super admin can read anyone's.
      allow read: if isOwner(uid) || isSuperAdmin();

      // A user can create their OWN profile at registration, but only as
      // status "pending" / role "user" — they cannot self-approve or
      // self-promote to superadmin.
      allow create: if isOwner(uid)
        && request.resource.data.status == "pending"
        && request.resource.data.role == "user";

      // Only a super admin can change status/role after that (approve/reject).
      // A user can still update their own non-privileged fields (e.g. name),
      // but not status or role.
      allow update: if isSuperAdmin()
        || (isOwner(uid)
            && request.resource.data.status == resource.data.status
            && request.resource.data.role == resource.data.role);

      allow delete: if isSuperAdmin();
    }

    // ---------------------------------------------------------------
    // Clients module (added for clients.html integration)
    // ---------------------------------------------------------------
    function isApproved() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == "approved";
    }

    match /clients/{clientId} {
      // Any approved (signed-in, cleared) user can view and manage clients.
      allow read, create, update: if isApproved();
      // Only a super admin can permanently delete a client record.
      allow delete: if isSuperAdmin();
    }

    // Read-only lookups the Clients page uses to show linked records —
    // written by their own future pages, not by any module built so far.
    match /complaints/{id} {
      allow read: if isApproved();
    }
    match /renewals/{id} {
      allow read, create, update: if isApproved();
      allow delete: if isSuperAdmin();
    }
    match /inspections/{id} {
      allow read: if isApproved();
    }

    // ---------------------------------------------------------------
    // Contracts module (added for contracts.html integration)
    // ---------------------------------------------------------------
    match /contracts/{contractId} {
      // Any approved user can view/create/edit contracts, including the
      // rollup fields (totalPaid, balanceRemaining, etc.) kept in sync by
      // js/contract-sync.js. Only a super admin can delete one outright.
      allow read, create, update: if isApproved();
      allow delete: if isSuperAdmin();
    }

    // Treatments/payments are child records of a contract — same access
    // as the contract itself, since editing a session/installment is
    // really editing part of the contract (see js/contract-sync.js).
    match /treatments/{id} {
      allow read, create, update: if isApproved();
      allow delete: if isSuperAdmin();
    }
    match /payments/{id} {
      allow read, create, update: if isApproved();
      allow delete: if isSuperAdmin();
    }

    // Teams module (used by treatments.html for team/technician rosters) —
    // kept as its own collection rather than a config/settings list, since
    // each doc carries a member/technician roster.
    match /teams/{id} {
      allow read, create, update: if isApproved();
      allow delete: if isSuperAdmin();
    }

    // Shared counters (customer/contract/treatment numbers) and settings
    // (sales agents, contract types, treatment types, booking statuses,
    // cancel/reschedule reasons, etc.)
    match /config/{id} {
      allow read, write: if isApproved();
    }

    // Append-only audit trail of client/contract changes.
    match /audit_log/{id} {
      allow read, create: if isApproved();
    }
  }
}
