rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isSuperAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "superadmin";
    }

    // A plain admin: can approve/deny users and manage roles up to (but
    // never including) superadmin — see the users/{uid} update rule below.
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // ── Pre-registration allowlist ──
    // config/preapproved holds { emails: { "<lowercase email>": { role,
    // permissions } } }. Rules can't search an array, which is why the
    // list is stored keyed by email — that makes it verifiable here.
    function preapprovedMap() {
      return exists(/databases/$(database)/documents/config/preapproved)
        ? get(/databases/$(database)/documents/config/preapproved).data.get("emails", {})
        : {};
    }

    function preapprovedEntry() {
      return isSignedIn() && request.auth.token.email != null
        ? preapprovedMap().get(request.auth.token.email.lower(), null)
        : null;
    }

    function preapprovedRole() {
      return preapprovedEntry() != null
        ? preapprovedEntry().get("role", "user")
        : "user";
    }

    function preapprovedPermissions() {
      return preapprovedEntry() != null
        ? preapprovedEntry().get("permissions", {})
        : {};
    }


    match /users/{uid} {
      // A user can read their own profile (needed to check pending/approved
      // status right after sign-in, before they're approved); a super admin
      // can read anyone's; and any already-approved user can read the list
      // too — Complaints' Assigned To dropdown needs to list every approved
      // user, not just admins.
      allow read: if isOwner(uid) || isSuperAdmin() || isApproved();

      // A user can create their OWN profile at registration. Normally
      // that means status "pending" / role "user" — nobody self-approves
      // and nobody self-promotes.
      //
      // The one exception is the pre-registration allowlist an admin
      // maintains in config/preapproved: if this exact email was put on
      // that list ahead of time, the new account may start "approved"
      // with the role the admin chose there. The claim is verified here
      // against the stored entry, so it can't be forged by a hand-made
      // request — the client never gets to decide its own status.
      allow create: if isOwner(uid) && (
        (request.resource.data.status == "pending" && request.resource.data.role == "user")
        || (
          preapprovedEntry() != null
          && request.resource.data.status == "approved"
          && request.resource.data.role == preapprovedRole()
          && request.resource.data.get("permissions", {}) == preapprovedPermissions()
        )
      );


      // Super admin: unrestricted. Admin: can update any user doc except
      // one that's currently superadmin, and can never set anyone's role
      // TO superadmin — mirrors user-management.html's own client-side
      // canChangeRole/canAssignSuper logic exactly, enforced here as the
      // real boundary. A user can still update their own non-privileged
      // fields (e.g. name), but not status or role.
      allow update: if isSuperAdmin()
        || (isAdmin()
            && resource.data.role != "superadmin"
            && request.resource.data.role != "superadmin")
        || (isOwner(uid)
            && request.resource.data.status == resource.data.status
            && request.resource.data.role == resource.data.role);

      allow delete: if isSuperAdmin();
    }

    // ---------------------------------------------------------------
    // Clients module (added for clients.html integration)
    // ---------------------------------------------------------------
    function isApproved() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == "approved";
    }

    match /clients/{clientId} {
      // Any approved (signed-in, cleared) user can view and manage clients.
      allow read, create, update: if isApproved();
      // Only a super admin can permanently delete a client record.
      allow delete: if isSuperAdmin();
    }

    // Read-only lookups the Clients page uses to show linked records —
    // written by their own future pages, not by any module built so far.
    match /complaints/{id} {
      allow read, create, update: if isApproved();
      allow delete: if isSuperAdmin();
    }
    match /renewals/{id} {
      allow read, create, update: if isApproved();
      allow delete: if isSuperAdmin();
    }
    match /inspections/{id} {
      allow read, create, update: if isApproved();
      allow delete: if isSuperAdmin();
    }

    // ---------------------------------------------------------------
    // Contracts module (added for contracts.html integration)
    // ---------------------------------------------------------------
    match /contracts/{contractId} {
      // Any approved user can view/create/edit contracts, including the
      // rollup fields (totalPaid, balanceRemaining, etc.) kept in sync by
      // js/contract-sync.js. Only a super admin can delete one outright.
      allow read, create, update: if isApproved();
      allow delete: if isSuperAdmin();
    }

    // Treatments/payments are child records of a contract — same access
    // as the contract itself, since editing a session/installment is
    // really editing part of the contract (see js/contract-sync.js).
    match /treatments/{id} {
      allow read, create, update: if isApproved();
      allow delete: if isSuperAdmin();
    }
    match /payments/{id} {
      allow read, create, update: if isApproved();
      allow delete: if isSuperAdmin();
    }

    // Teams module (used by treatments.html for team/technician rosters) —
    // kept as its own collection rather than a config/settings list, since
    // each doc carries a member/technician roster.
    match /teams/{id} {
      allow read, create, update: if isApproved();
      allow delete: if isSuperAdmin();
    }

    // Shared counters (customer/contract/treatment numbers) and settings
    // (sales agents, contract types, treatment types, booking statuses,
    // cancel/reschedule reasons, etc.)
    match /config/{id} {
      allow read, write: if isApproved();
    }

    // The allowlist is the one config document a not-yet-approved user
    // has to read: the registration form checks it to know whether this
    // signup is pre-cleared. Read-only, signed-in only, and writable
    // solely by admins through User Management.
    match /config/preapproved {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isSuperAdmin();
    }

    // Append-only audit trail of client/contract changes.
    match /audit_log/{id} {
      allow read, create: if isApproved();
    }
  }
}
